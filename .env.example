# Copy to /srv/cooking-planner/.env on your server and fill in. Never commit .env.
# Create it locked down BEFORE adding secrets:  sudo install -m 600 /dev/null .env
# (Cooking Planner has no secrets today, so this file only sets the user and time zone.)
TZ=Europe/London

# --- Container user (same as my other containers) ---
PUID=1003
PGID=1006

# --- Optional ---
# Log detail: info (default), warn, error, debug
# LOG_LEVEL=info
